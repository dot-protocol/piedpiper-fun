{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/chat/:path*",
      "destination": "http://69.62.114.97/chat/:path*"
    },
    {
      "source": "/chat",
      "destination": "http://69.62.114.97/chat/"
    }
  ],
  "redirects": [
    {
      "source": "/c/:path*",
      "destination": "https://qr-chat-kohl.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/c",
      "destination": "https://qr-chat-kohl.vercel.app/",
      "permanent": false
    }
  ],
  "functions": {
    "api/compress.py": {
      "runtime": "@vercel/python@4.3.1",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/dot.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }
      ]
    },
    {
      "source": "/data/(.*)\\.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=60" }
      ]
    },
    {
      "source": "/send-preview/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Service-Worker-Allowed", "value": "/send-preview/" }
      ]
    },
    {
      "source": "/send-preview/service-worker.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/send-preview/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
